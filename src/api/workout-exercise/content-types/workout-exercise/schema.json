{
  "kind": "collectionType",
  "collectionName": "workout_exercises",
  "info": {
    "singularName": "workout-exercise",
    "pluralName": "workout-exercises",
    "displayName": "WorkoutExercise"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "order": {
      "type": "integer",
      "required": true
    },
    "execution_status": {
      "type": "enumeration",
      "default": "PENDING",
      "enum": [
        "PENDING",
        "COMPLETED",
        "SKIPPED"
      ]
    },
    "was_modified": {
      "type": "boolean",
      "default": false
    },
    "notes": {
      "type": "text"
    },
    "workout": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::workout.workout",
      "inversedBy": "workout_exercises"
    },
    "program_exercise": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::program-exercise.program-exercise",
      "inversedBy": "workout_exercises"
    },
    "sets": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::set.set",
      "mappedBy": "workout_exercise"
    },
    "override_sets": {
      "type": "integer",
      "min": 1
    },
    "override_reps_min": {
      "type": "integer",
      "min": 1
    },
    "override_reps_max": {
      "type": "integer",
      "min": 1
    },
    "override_load": {
      "type": "decimal",
      "min": 0
    },
    "override_duration": {
      "type": "integer",
      "min": 0
    },
    "override_distance": {
      "type": "decimal",
      "min": 0
    }
  }
}
