{
  "kind": "collectionType",
  "collectionName": "workout_templates",
  "info": {
    "singularName": "workout-template",
    "pluralName": "workout-templates",
    "displayName": "WorkoutTemplate"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "name": {
      "type": "string",
      "required": true
    },
    "description": {
      "type": "text"
    },
    "category": {
      "type": "enumeration",
      "enum": [
        "UPPER",
        "LOWER",
        "PUSH",
        "PULL",
        "LEGS",
        "FULL_BODY"
      ]
    },
    "order": {
      "type": "integer"
    },
    "program": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::program.program",
      "inversedBy": "workout_templates"
    },
    "program_exercises": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::program-exercise.program-exercise",
      "mappedBy": "workout_template"
    },
    "workouts": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::workout.workout",
      "mappedBy": "workout_template"
    }
  }
}
